# NeoBot Backend Environment Configuration

# Server Port (Render sets this automatically via process.env.PORT)
PORT=3000

# Google Gemini API Key (keep this private; never commit .env or expose to client)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini Model for Multimodal Live Audio/Video
# Supported live models: gemini-2.5-flash or gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.5-flash

# Prebuilt Voice Name (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE=Puck

# Robot Persona Name
ROBOT_NAME=NeoBot

# Allowed Frontend Origin for CORS (e.g. https://your-username.github.io)
# Use * for local testing or comma-separated list of origins in production
ALLOWED_ORIGIN=*
